# ============================================================================
# Environment configuration for Docker Compose (development)
#
# How to use:
#   1. Copy this file to `.env`  (e.g. `cp .env.example .env` on Linux/macOS,
#      `Copy-Item .env.example .env` on PowerShell)
#   2. Replace every placeholder value below with your own development values.
#   3. Run `docker compose up -d --build`.
#
# IMPORTANT:
#   - `.env` is git-ignored and must NEVER be committed.
#   - Never use these placeholder values in any real (public) deployment.
#   - Generate a strong JWT secret for real environments, e.g.:
#        openssl rand -base64 64
# ============================================================================

# PostgreSQL superuser password (used by the postgres service and the app).
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# Base64-encoded secret used to sign JWTs (HMAC-SHA256).
# Must decode to at least 256 bits (32 bytes). Use a random value in real deploys.
JWT_SECRET=am9icGxhdGZvcm0tZGV2LXNlY3JldC1DSEFOR0UtTUUtYmVmb3JlLXB1YmxpYy1kZXBsb3ktcGxlYXNlLTEyMzQ1Njc4OTA=

# Grafana admin password.
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD